/* SPDX-License-Identifier: GPL-2.0-or-later */

stdin=serial
stdout=serial
stderr=serial

bootdelay=3
scriptaddr=0x41f00000
loadaddr=0x42000000
kernel_addr_r=0x42000000
fdt_addr_r=0x44f00000
ramdisk_addr_r=0x45000000
bootargs=console=ttyAMA0 earlycon root=/dev/mmcblk0p1 rootfstype=ext4 rw init=/init

bootcmd=source ${scriptaddr}
